#!/usr/bin/env bash
# Runs a QML file against the installed Omarchy shell modules in a temporary,
# offscreen shell; never touches desktop config. Usage: run-qml FILE TIMEOUT
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shell_root="${OMARCHY_SHELL_ROOT:-/usr/share/omarchy/shell}"
command -v quickshell >/dev/null || { echo 'quickshell not found.' >&2; exit 1; }
[[ -d "$shell_root/Commons" ]] || { echo 'Omarchy shell not found; set OMARCHY_SHELL_ROOT.' >&2; exit 1; }
tmp="$(mktemp -d -t sysmon-qml.XXXXXX)"
trap 'rm -rf "$tmp"' EXIT
for module in Commons Ui services; do ln -s "$shell_root/$module" "$tmp/$module"; done
ln -s "$root" "$tmp/plugin"
cp "$1" "$tmp/shell.qml"
status=0
QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software timeout "$2" quickshell --no-color -p "$tmp/shell.qml" > "$tmp/log" 2>&1 || status=$?
cat "$tmp/log"
exit "$status"
