#!/usr/bin/env bash
# Native live-data render check of every view, a compact window and a light
# palette. Set SYSMON_CAPTURE_DIR to keep the rendered frames.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
log="$(mktemp -t sysmon-smoke.XXXXXX)"
trap 'rm -f "$log"' EXIT
"$here/run-qml" "$here/qml-smoke.qml" 45 > "$log" || { cat "$log"; exit 1; }
cat "$log"
rg -q SMOKE_OK "$log"
if rg 'SMOKE_FAILED|ReferenceError|TypeError|Error:|Binding loop|Cannot assign|Unable to assign|is not defined|is not a function|Failed to load configuration' "$log"; then exit 1; fi
