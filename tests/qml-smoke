#!/usr/bin/env bash
# Native live-data render check. Uses a temporary shell; never changes desktop config.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shell_root="${OMARCHY_SHELL_ROOT:-/usr/share/omarchy/shell}"
command -v quickshell >/dev/null
[[ -d "$shell_root/Commons" ]] || { echo 'Omarchy shell not found; set OMARCHY_SHELL_ROOT.' >&2; exit 1; }
tmp="$(mktemp -d -t sysmon-smoke.XXXXXX)"
trap 'rm -rf "$tmp"' EXIT
for module in Commons Ui services; do ln -s "$shell_root/$module" "$tmp/$module"; done
ln -s "$root" "$tmp/plugin"
cp "$root/tests/qml-smoke.qml" "$tmp/shell.qml"
QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software timeout 35 quickshell --no-color -p "$tmp/shell.qml" > "$tmp/log" 2>&1 || { cat "$tmp/log"; exit 1; }
cat "$tmp/log"
rg -q SMOKE_OK "$tmp/log"
if rg 'SMOKE_FAILED|ReferenceError|TypeError|Error:|Binding loop|Cannot assign|Unable to assign|is not defined|is not a function|Failed to load configuration' "$tmp/log"; then exit 1; fi
